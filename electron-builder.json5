// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",

  "appId": "com.katip.otoservis",
  "asar": true,
  "productName": "Kâtip",

  "directories": {
    "output": "release/${version}"
  },

  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],

  "asarUnpack": [
    "node_modules/better-sqlite3/**/*"
  ],

  "publish": {
    "provider": "github",
    "owner": "alicankala",
    "repo": "katip-64bit"
  },

"win": {
  "icon": "public/icon.ico",
  "target": [
    {
      "target": "nsis",
      "arch": [
        "x64"
      ]
    }
  ],
  // Dosya adi bilerek ASCII: "Kâtip" icindeki 'â' yuzunden electron-builder
  // latest.yml'ye guvenli (ASCII) bir ad yaziyor, uretilen dosya ise ${productName}
  // ile adlandiriliyordu. Ikisi tutmayinca guncelleyici dosyayi bulamayip
  // sessizce basarisiz oluyordu. productName degismiyor, yalnizca dosya adi.
  "artifactName": "Katip-Windows-${version}-Setup.${ext}"
},
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowToChangeInstallationDirectory": false,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Kâtip",
    "installerIcon": "public/icon.ico",
    "uninstallerIcon": "public/icon.ico"
  }
}
