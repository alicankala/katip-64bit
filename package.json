  "private": true,
  "version": "1.8.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && electron-builder",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:integration && npm run test:business && npm run test:stage4",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:business": "vitest run --config vitest.business.config.ts",
    "test:business:watch": "vitest --config vitest.business.config.ts",
    "test:stage4": "vitest run --config vitest.stage4.config.ts",
    "test:stage4:watch": "vitest --config vitest.stage4.config.ts",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:smoke:watch": "vitest --config vitest.smoke.config.ts",
    "check:sync": "node scripts/check-architecture-sync.cjs",
    "check:release-contract": "node scripts/check-release-contract.cjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@primevue/themes": "^4.5.4",
    "@types/qrcode": "^1.5.6",
    "better-sqlite3": "^12.11.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "qrcode": "^1.5.4",
    "vue": "^3.4.21",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^42.7.0",
    "electron-builder": "^26.15.7",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "2.1.9",
    "vue-tsc": "^2.0.26"
  },
  "main": "dist-electron/main.js"
}
